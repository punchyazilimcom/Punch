# ============================================================
#  PUNCH YAZILIM - Ortam Degiskenleri (.env)
#  Bu dosyayi ".env" olarak kopyalayip degerleri doldurun.
#  .env ASLA commit'lenmez (bkz: .gitignore).
# ============================================================

# --- Uygulama ---
APP_NAME="Punch Yazilim"
APP_ENV=production            # local | production
APP_DEBUG=false               # production'da daima false
APP_URL=https://punchyazilim.com
APP_TIMEZONE=Europe/Istanbul
APP_LOCALE=tr
# Asset cache-busting icin surum (deploy'da degistirin veya commit hash kullanin)
ASSET_VERSION=1.0.0
# Uygulama genel sirri (oturum/token icin). 'php -r "echo bin2hex(random_bytes(32));"'
APP_KEY=

# --- Veritabani (MySQL 8 / MariaDB) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u732850246_Punchv1
DB_USER=
DB_PASS=
DB_CHARSET=utf8mb4

# --- Oturum / Guvenlik ---
SESSION_NAME=punch_session
SESSION_LIFETIME=120          # dakika
COOKIE_SECURE=true            # HTTPS'te true
COOKIE_SAMESITE=Lax           # Lax | Strict
# Admin paneli icin opsiyonel IP allowlist (virgulle ayrilmis). Bos = herkese acik.
ADMIN_IP_ALLOWLIST=

# --- E-posta (SMTP / PHPMailer) ---
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_ENCRYPTION=ssl           # ssl (465) | tls (587)
MAIL_USERNAME=destek@punchyazilim.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=destek@punchyazilim.com
MAIL_FROM_NAME="Punch Yazilim"
MAIL_ADMIN_ADDRESS=destek@punchyazilim.com

# --- PayTR iFrame API ---
# https://www.paytr.com/magaza/ayarlar adresinden alinir.
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
PAYTR_TEST_MODE=1             # 1 = test, 0 = canli
PAYTR_NOTIFY_URL=https://punchyazilim.com/paytr-notify.php
PAYTR_OK_URL=https://punchyazilim.com/odeme/basarili
PAYTR_FAIL_URL=https://punchyazilim.com/odeme/basarisiz

# --- Analitik / Dogrulama (panelden de duzenlenebilir) ---
GA4_MEASUREMENT_ID=
GOOGLE_SITE_VERIFICATION=

# --- Sirket / Yerel SEO bilgileri (seed/varsayilan) ---
COMPANY_NAME="Punch Yazilim"
COMPANY_PHONE=
COMPANY_WHATSAPP=
COMPANY_EMAIL=destek@punchyazilim.com
COMPANY_ADDRESS="Yenimahalle, Ankara"
COMPANY_CITY=Ankara
